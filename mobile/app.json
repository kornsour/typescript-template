{
	"expo": {
		"name": "TypeScript Template",
		"slug": "typescript-template",
		"scheme": "typescript-template",
		"version": "0.1.0",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "com.example.typescripttemplate",
			"supportsTablet": true
		},
		"android": {
			"package": "com.example.typescripttemplate"
		},
		"plugins": ["expo-router", "expo-secure-store"]
	}
}
