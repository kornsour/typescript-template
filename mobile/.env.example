# Copy to mobile/.env.local (or .env) and edit. EXPO_PUBLIC_* values are inlined
# into the app bundle, so never put secrets here.

# Origin of the web app that serves the API, e.g. https://app.example.com
# (no path, no trailing slash).
#
# Development: leave unset to use port 3000 on the machine running Expo, so a
# physical phone on the same network works.
# Production builds: REQUIRED. The app fails at startup without it.
# EXPO_PUBLIC_API_URL=
